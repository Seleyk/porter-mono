{
  "expo": {
    "name": "Porter Driver",
    "slug": "porter-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.porter.driver",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0F14"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.porter.driver"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Porter shows you nearby jobs and shares your location with your customer while you're on a job."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Porter uses the camera to take a proof-of-delivery photo when you drop off an item.",
          "photosPermission": false
        }
      ]
    ],
    "scheme": "porterdriver",
    "extra": {
      "router": {}
    }
  }
}
